# Copy to server/.env for local use, and add the same keys on Render → Environment.
# Never commit the real .env.

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/thereset
JWT_SECRET=paste-a-long-random-string-here          # node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PORT=5000

# Live sites allowed to call the API (comma separated)
ALLOWED_ORIGINS=https://the-reset-snowy.vercel.app,https://the-reset-admin.vercel.app

# Used in email links (reset password, view order, unsubscribe)
SHOP_URL=https://the-reset-snowy.vercel.app
API_URL=https://the-reset-api.onrender.com

# Email (any SMTP). Leave SMTP_HOST empty to print emails to the log instead.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="THE RESET <your-verified-sender@gmail.com>"

# Product photo uploads (cloudinary.com → Dashboard → API keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shown on invoices. Without SHOP_GSTIN the invoice has no GST lines.
SHOP_LEGAL_NAME="THE RESET"
SHOP_ADDRESS=
SHOP_STATE=Delhi
SHOP_GSTIN=
SHOP_EMAIL=

# "Still in your bag?" emails run on Render automatically. Set to off to stop
# them, or on to run them on your own computer (careful: same database).
BAG_REMINDERS=

# Morning email for the team (orders to confirm/ship, returns, low stock,
# yesterday's sales for the owner). Runs on Render; off to stop it.
DAILY_DIGEST=
# Hour it goes out, India time (0-23). Default 9.
DIGEST_HOUR=9

# Invite a friend: both get this much store credit (₹) once the friend's first
# order of at least REFERRAL_MIN (₹) is delivered. REFERRALS=off to switch off.
REFERRALS=
REFERRAL_REWARD=200
REFERRAL_MIN=999

# Cash on delivery: optional fee and upper limit (₹)
COD_FEE=0
COD_MAX=10000

# Online payments (Razorpay → Settings → API keys). Leave empty to offer
# cash on delivery only. Start with the rzp_test_ keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Settings → Webhooks → URL .../api/payments/razorpay/webhook,
# events payment.captured + order.paid, and the same secret here.
RAZORPAY_WEBHOOK_SECRET=

# Only for: node seedAdmin.js
ADMIN_EMAIL=
ADMIN_PASSWORD=
