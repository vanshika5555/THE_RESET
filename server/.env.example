# Copy to server/.env for local use, and add the same keys on Render → Environment.
# Never commit the real .env.

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/thereset
JWT_SECRET=paste-a-long-random-string-here          # node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PORT=5000

# Live sites allowed to call the API (comma separated)
ALLOWED_ORIGINS=https://the-reset-snowy.vercel.app,https://the-reset-admin.vercel.app

# Used in email links (reset password, view order)
SHOP_URL=https://the-reset-snowy.vercel.app

# Email (any SMTP). Leave SMTP_HOST empty to print emails to the log instead.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="THE RESET <your-verified-sender@gmail.com>"

# Only for: node seedAdmin.js
ADMIN_EMAIL=
ADMIN_PASSWORD=
